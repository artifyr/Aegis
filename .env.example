# Authentication
AUTH_USER=your_username_here
AUTH_PASS=your_secure_password_here
GUEST_USER=guest
GUEST_PASS=guest

# Maritime AIS Service Key
AIS_API_KEY=your_ais_api_key_here
NEXT_PUBLIC_AIS_API_KEY=your_ais_api_key_here

# Google Gemini Intelligence Keys (Supports rotation across keys 1-6)
GEMINI_API_KEY_1=your_gemini_api_key_here
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Supabase Realtime & DB
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Mapbox GL Token
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
