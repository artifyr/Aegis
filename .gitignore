!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# venv
/backend/venv
/venv
.venv/
env/

# pycache
__pycache__/
*.py[cod]
*$py.class
/backend/__pycache__/
/backend/routers/__pycache__/
/backend/inference/__pycache__/

# misc
*.log
.vscode/

# next.js
/.next/
/out/
/build

.vercel

# graphify
graphify-out/
.graphify/

# gemini
.gemini/

# tempdocs & scratch
tempdocs/
scratch/

# root helper scripts (exclude config files)
/*.js
!/tailwind.config.js
!/postcss.config.js
!/postcss.config.mjs
!/eslint.config.mjs

# other unnecessary files
old_map.txt

