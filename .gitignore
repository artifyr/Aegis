# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example as template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# venv
/backend/venv
/venv
.venv/
env/

# pycache
__pycache__/
*.py[cod]
*$py.class
/backend/__pycache__/
/backend/routers/__pycache__/
/backend/inference/__pycache__/

# misc
*.log
# IDE & editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.antigravity/
.agents/
.cursor/

# OS metadata
.DS_Store
Thumbs.db

# next.js
/.next/
/out/
/build

.vercel

# gemini
.gemini/

# tempdocs & scratch
tempdocs/
scratch/

# root helper scripts (exclude config files)
/*.js
!/tailwind.config.js
!/postcss.config.js
!/postcss.config.mjs
!/eslint.config.mjs

# other unnecessary files
old_map.txt

# temporary reference clones
/*_temp/
/*-temp/

# private docs & checklists (keep local only)
SECURITY_CHECKLIST.md
roadmap.md
PROGRESS.md
TASKLIST.md
.antigravityignore
/docs/